{
  "name": "eska-explorer",
  "displayName": "eska: 1C Explorer",
  "description": "%description%",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.109.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1c-tooling/eska-vscode-explorer.git"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:eska.explorer.projects"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%trust%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%virtual%"
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "bun run --bun compile && bun test",
    "test:node": "npm run compile && node --test test/*.test.mjs",
    "test:integration": "bun run --bun compile && bun test test/integration.test.mjs test/tree.test.mjs test/search.test.mjs",
    "test:host": "bun run --bun compile && bun test/run-host.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/vscode": "1.109.0",
    "typescript": "7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "eska.explorer.connect",
        "title": "%connect%",
        "category": "eska Explorer",
        "icon": "$(plug)"
      },
      {
        "command": "eska.explorer.restart",
        "title": "%restart%",
        "category": "eska Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "eska.explorer.disconnect",
        "title": "%disconnect%",
        "category": "eska Explorer",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "eska.explorer.showLog",
        "title": "%showLog%",
        "category": "eska Explorer",
        "icon": "$(output)"
      },
      {
        "command": "eska.explorer.refresh",
        "title": "%refresh%",
        "category": "eska Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "eska.explorer.refreshNode",
        "title": "%refresh%",
        "category": "eska Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "eska.explorer.openSource",
        "title": "%openSource%",
        "category": "eska Explorer"
      },
      {
        "command": "eska.explorer.openXml",
        "title": "%openXml%",
        "category": "eska Explorer"
      },
      {
        "command": "eska.explorer.search",
        "title": "%search%",
        "category": "eska Explorer",
        "icon": "$(search)"
      },
      {
        "command": "eska.explorer.hideEmptyGroups",
        "title": "%hideEmptyGroups%",
        "category": "eska Explorer",
        "icon": "$(filter)"
      },
      {
        "command": "eska.explorer.showEmptyGroups",
        "title": "%showEmptyGroups%",
        "category": "eska Explorer",
        "icon": "$(filter-filled)"
      },
      {
        "command": "eska.explorer.resetRootFilter",
        "title": "%resetRootFilter%",
        "category": "eska Explorer"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "eska.explorer.projects",
          "name": "eska: 1C Explorer",
          "visibility": "collapsed",
          "contextualTitle": "eska: 1C Explorer"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "eska.explorer.connect",
          "when": "view == eska.explorer.projects",
          "group": "navigation@1"
        },
        {
          "command": "eska.explorer.refresh",
          "when": "view == eska.explorer.projects",
          "group": "navigation@2"
        },
        {
          "command": "eska.explorer.restart",
          "when": "view == eska.explorer.projects",
          "group": "connection@1"
        },
        {
          "command": "eska.explorer.disconnect",
          "when": "view == eska.explorer.projects",
          "group": "navigation@3"
        },
        {
          "command": "eska.explorer.showLog",
          "when": "view == eska.explorer.projects",
          "group": "navigation@4"
        },
        {
          "command": "eska.explorer.search",
          "when": "view == eska.explorer.projects",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "eska.explorer.openXml",
          "when": "view == eska.explorer.projects && viewItem == eskaCommonModule",
          "group": "navigation"
        },
        {
          "command": "eska.explorer.refreshNode",
          "when": "view == eska.explorer.projects && (viewItem == eskaMetadata || viewItem == eskaCommonModule || viewItem == eskaRootFiltered || viewItem == eskaRootUnfiltered)",
          "group": "inline"
        },
        {
          "command": "eska.explorer.hideEmptyGroups",
          "when": "view == eska.explorer.projects && viewItem == eskaRootUnfiltered",
          "group": "inline@0"
        },
        {
          "command": "eska.explorer.showEmptyGroups",
          "when": "view == eska.explorer.projects && viewItem == eskaRootFiltered",
          "group": "inline@0"
        },
        {
          "command": "eska.explorer.resetRootFilter",
          "when": "view == eska.explorer.projects && (viewItem == eskaRootFiltered || viewItem == eskaRootUnfiltered)",
          "group": "filter@1"
        }
      ],
      "commandPalette": [
        {
          "command": "eska.explorer.openXml",
          "when": "false"
        },
        {
          "command": "eska.explorer.refreshNode",
          "when": "false"
        },
        {
          "command": "eska.explorer.openSource",
          "when": "false"
        },
        {
          "command": "eska.explorer.hideEmptyGroups",
          "when": "false"
        },
        {
          "command": "eska.explorer.showEmptyGroups",
          "when": "false"
        },
        {
          "command": "eska.explorer.resetRootFilter",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "eska: 1C Explorer",
      "properties": {
        "eska.explorer.executable": {
          "type": "string",
          "default": "eska",
          "scope": "machine-overridable",
          "description": "%executable%"
        },
        "eska.explorer.treeLanguage": {
          "type": "string",
          "enum": ["auto", "ru-RU", "en-US"],
          "enumItemLabels": ["%treeLanguageAuto%", "%treeLanguageRussian%", "%treeLanguageEnglish%"],
          "default": "auto",
          "scope": "window",
          "description": "%treeLanguage%"
        },
        "eska.explorer.hideEmptyRootGroups": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%hideEmptyRootGroups%"
        }
      }
    }
  }
}
